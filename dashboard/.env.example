# Jamie Dashboard (its own Vercel project, Root Directory = dashboard). Set these in Vercel, never commit real values.

# Required: the password you type on the login page. Long and unique.
DASHBOARD_PASSWORD=

# Required: random string, at least 32 characters, used to sign the login cookie.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it (or the password) signs everyone out.
DASHBOARD_SESSION_SECRET=

# Database: the same Neon database as jamie-mcp. The first one that is set is used.
# Optional but best: a read-only Postgres role just for the dashboard (see README).
DASHBOARD_DATABASE_URL=
# Otherwise the same connection string jamie-mcp uses (Vercel's Neon integration sets DATABASE_URL and POSTGRES_URL).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
