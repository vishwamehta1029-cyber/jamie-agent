{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/public/portfolio.json",
      "destination": "/api/mcp?view=portfolio"
    },
    {
      "source": "/:secret/resume/:variant",
      "destination": "/api/mcp?k=:secret&view=resume&variant=:variant"
    },
    {
      "source": "/:secret/mcp",
      "destination": "/api/mcp?k=:secret"
    },
    {
      "source": "/:secret/brain",
      "destination": "/api/mcp?k=:secret&view=brain"
    },
    {
      "source": "/:secret/seed",
      "destination": "/api/mcp?k=:secret&view=seed"
    }
  ]
}
