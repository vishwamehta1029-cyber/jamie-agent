# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 24 characters. It becomes part of your connector URL.
JAMIE_SECRET=replace-with-a-long-random-string

# ---------- Entrepreneur (daily cron). Values are set in Vercel, never committed. ----------
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/entrepreneur. At least 16 characters.
CRON_SECRET=
# Apollo People Match (only Apollo-verified emails are used)
APOLLO_API_KEY=
# The only LLM call: the [WHY LINE]
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Gmail API (OAuth refresh token for the sending account, scope gmail.send + gmail.readonly)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=vishwamehta1011@gmail.com
# Optional tuning (defaults shown)
ENT_DAILY_EMAIL_TARGET=100
ENT_BATCH_SIZE=10
ENT_SEND_DELAY_MS=2000
ENT_TIME_BUDGET_MS=50000
ENT_MAX_FOUNDERS_PER_COMPANY=3
ENT_APOLLO_DAILY_CREDITS=150
ENT_DISCOVERY_PAGES=2
ENT_DISCOVERY_EVERY_HOURS=20
# 1 = build everything, send nothing (same as the entrepreneur_dry_run setting)
ENT_DRY_RUN=
# Optional: YC directory's public Algolia search config, only if auto-detection from ycombinator.com/companies breaks
YC_ALGOLIA_APP_ID=
YC_ALGOLIA_API_KEY=
YC_ALGOLIA_INDEX=YCCompany_production
